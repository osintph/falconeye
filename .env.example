# FalconEye environment configuration
# Copy this file to /opt/falconeye/.env on your VPS and fill in the values.
# All keys are optional unless marked REQUIRED, the relevant feature degrades
# gracefully if a key is absent, except where REQUIRED means the app will fail
# to start or that feature will crash on use.
#
# After editing: chmod 600 /opt/falconeye/.env

# ----- Database -----
# Path to the SQLite database file. The default works for standard installs.
# The code reads FALCONEYE_DB (not DB_PATH, an older alias that was retired).
# Upgrading from v3.4.0 or earlier: rename DB_PATH= to FALCONEYE_DB= in this file.
FALCONEYE_DB=/opt/falconeye/data/falconeye.db

# Directory for transient data (image upload temp files, etc.).
# Defaults to /opt/falconeye/data. Rarely needs changing.
# FALCONEYE_DATA_DIR=/opt/falconeye/data

# ----- LLM features -----
# Anthropic API key for Email Header LLM analysis, Dork Generator, and Script Decoder.
# Get one at https://console.anthropic.com. Set a monthly spend limit before deploying.
# Also install the SDK: pip install "anthropic>=0.25"
ANTHROPIC_API_KEY=

# Kill switches for individual LLM-powered tabs. Set to "false" to disable.
LLM_ANALYSIS_ENABLED=true
LLM_DORKGEN_ENABLED=true
LLM_DECODER_ENABLED=true

# ----- IP Reputation tab -----
# GreyNoise Community API: https://viz.greynoise.io/account
GREYNOISE_API_KEY=

# ----- IP Reputation: multi-source threat intel (v3.9.0) -----
# All of the below are optional. Each source degrades on its own sub-card if its
# key is missing/invalid/quota-hit, a failing source never blanks the tab.
#
# The verdict is computed over the four unmetered sources (AbuseIPDB,
# VirusTotal, AlienVault OTX, ThreatFox). Censys is enrichment only, see its
# block below.
# Do NOT put comments on the value lines themselves (getenv_clean strips inline
# "# ..." comments, but keep them on preceding lines for clarity). Never log,
# echo, or commit any of these values. See docs/ip-reputation-sources.md.
#
# AbuseIPDB, abuse-confidence score, reports, categories. 1,000 checks/day free.
# Get a key: https://www.abuseipdb.com/account/api
ABUSEIPDB_KEY=
#
# VirusTotal, multi-vendor detection ratio + flagged vendors. 500/day, 4/min free.
# Get a key: https://www.virustotal.com/gui/my-apikey
VT_KEY=
#
# AlienVault OTX, community pulses + malware families.
# Get a key: https://otx.alienvault.com/api
OTX_API_KEY=
#
# Censys Platform, host services and open ports. ENRICHMENT ONLY: it adds ports
# to the card and never votes on the reputation verdict, and it being absent,
# exhausted or switched off never makes a verdict INCOMPLETE.
#
# DEFAULT OFF, because the call is metered. Verified 2026-09-27 against
# https://docs.censys.com/docs/platform-credits-free-starter: a host lookup
# costs 1 Censys credit, Censys Free gets 100 credits a month and unused
# credits expire at the end of the month, so the free allowance is about three
# lookups a day. When the balance is spent the API answers HTTP 422 and the card
# shows a grey "monthly credits exhausted" note rather than an error.
CENSYS_ENABLED=false
#
# Censys Platform Personal Access Token (needed only when CENSYS_ENABLED=true).
# The PAT is organization-scoped, so no org ID is needed; leave CENSYS_ORG_ID
# unset unless you have a real UUID (a placeholder value causes an HTTP 422).
CENSYS_PAT=
# CENSYS_ORG_ID=
#
# ThreatFox (abuse.ch) IOC matches reuses ABUSECH_AUTH_KEY below, no separate key.

# ----- Sandbox History tab -----
# abuse.ch auth key (free): https://auth.abuse.ch
# Used by Sandbox History and IP Reputation tabs.
ABUSECH_AUTH_KEY=

# ----- Prospect tab -----
# SearchAPI.io key. REQUIRED if PROSPECT_ENABLED=true.
# Also used by the Image Search tab (same key, two features).
# Get one at https://www.searchapi.io (free trial available).
# NEVER log, echo, or commit this value.
SEARCHAPI_KEY=

# Kill switch for the Prospect tab. Set to "false" to disable without redeploying.
PROSPECT_ENABLED=true

# Redis connection URL for Prospect response cache (6-hour TTL).
# Defaults to local Redis on the standard port.
# REDIS_URL=redis://localhost:6379

# ----- Image Search tab -----
# Kill switches for the Image Search tab and Yandex sub-engine.
IMAGE_SEARCH_ENABLED=true
IMAGE_SEARCH_YANDEX_ENABLED=true

# HMAC secret for signed temporary upload URLs. REQUIRED if IMAGE_SEARCH_ENABLED=true.
# Generate a fresh value: openssl rand -hex 32
# NEVER log, echo, or commit this value.
IMAGE_UPLOAD_SECRET=

# Public origin used in signed URL construction. Must match your deployed domain.
SITE_ORIGIN=https://falconeye.osintph.info

# ----- Phishing Scanner enrichment -----
# urlscan.io API key (optional). Without a key, the free tier works at a lower
# rate limit. Get one at https://urlscan.io/user/profile/ (free account).
# URLSCAN_API_KEY=

# ----- Abuse Reporting (IP Reputation + Email Header tabs) -----
# Reporter identity. REQUIRED for the /api/abuse/compose endpoint (the Preview
# button). Abuse desks ignore anonymous reports, so both must be set. The
# reply-to address must be a real inbox you check, replies land there.
FALCONEYE_REPORTER_NAME="Your Name, Your Org"
FALCONEYE_REPORTER_EMAIL="abuse-reports@example.com"

# Mailgun send (OPTIONAL, only needed for the "Send via Mailgun" button).
# Leave MAILGUN_API_KEY blank to run in compose-and-copy-only mode.
# NEVER log, echo, or commit MAILGUN_API_KEY.
MAILGUN_API_KEY=
# Your Mailgun-verified sending domain. The domain part of MAILGUN_FROM below
# MUST match this exactly or Mailgun silently rejects the send.
MAILGUN_DOMAIN=email.example.com
# Mailgun account region: "us" (api.mailgun.net) or "eu" (api.eu.mailgun.net).
# No inline comments on this line, set the bare value only.
MAILGUN_REGION=us
# From address. Must be at MAILGUN_DOMAIN.
MAILGUN_FROM=reports@email.example.com

# Admin HTTP Basic Auth for the send endpoint. FALCONEYE_ABUSE_ADMIN_PASS_HASH
# is a bcrypt hash (starts with $2b$), NOT a plaintext password. Generate with:
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
FALCONEYE_ABUSE_ADMIN_USER=admin
FALCONEYE_ABUSE_ADMIN_PASS_HASH=

# ----- Telegram Intelligence tab -----
# Three tiers degrade independently: leaving any of these blank disables only
# that tier, which is a normal configuration and not an error.
#
# Tier 2 (Bot API). Create a bot with @BotFather and paste the token.
# NEVER log, echo, or commit this value.
TELEGRAM_BOT_TOKEN=

# Tier 3 (MTProto via Telethon). API ID and hash come from https://my.telegram.org
# (API development tools). TELEGRAM_SESSION_PATH points at a pre-authorised
# Telethon session file: tier 3 stays off until that file exists, because the
# login is interactive and cannot happen inside the service.
# Keep the session file outside the git tree and chmod 600 it. It is a live
# credential for the Telegram account that created it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/opt/falconeye/private/falconeye.session

# ----- Breach Check tab -----
# Have I Been Pwned API key (paid, Core tier or above). Without it the tab's
# account-breach lookups return nothing. The Pwned Passwords check is a separate
# free API and keeps working regardless.
# Get one at https://haveibeenpwned.com/API/Key
# NEVER log, echo, or commit this value.
HIBP_API_KEY=

# ----- Ransomware Watch tab -----
# ransomware.live PRO API key, used only by the collector
# (app/collectors/ransomware_collect.py), which runs from a systemd timer that
# lives outside this repo. The tab itself only reads the database below, so the
# tab works with no key as long as something has populated it.
# See docs/ransomware-watch-runbook.md.
RANSOMWARE_LIVE_API_KEY=

# Separate SQLite file from the main app database. The default works for
# standard installs.
# RANSOMWARE_DB=/opt/falconeye/data/ransomware.db

# Newline-separated search terms used to flag locally relevant victims,
# '#' comments allowed. Deliberately kept outside the git tree: it is
# operational config, not application code. The feature degrades to "no local
# matches" if the file is absent.
# RANSOMWARE_WATCHLIST_PATH=/opt/falconeye/private/ransomware_watchlist.txt

# ----- Sock Puppet tab -----
# Kill switch for LLM-generated personas. Set to "false" to disable. The tab
# still serves its non-LLM generators when off.
LLM_SOCKPUPPET_ENABLED=true

# Per-IP daily cap on LLM persona generations. Minimum 1; default 25.
# SOCKPUPPET_LLM_PER_DAY=25

# ----- Hudson Rock infostealer intelligence (v3.33.0) -----
# Adds infostealer exposure to Domain Intel (by domain) and to the Email Header
# tab's risk assessment (by sender address). Offered by Hudson Rock in GitHub
# issue #1.
#
# DEFAULT OFF, deliberately. Verified 2026-09-21: the free "osint-tools"
# endpoints need no API key, but Hudson Rock publishes no rate limit and no
# terms of use for them. That makes this a best-effort source an operator opts
# into with their eyes open, not something enabled on everyone's behalf. If the
# endpoints change or go away, both tabs look exactly as they do with this off.
#
# Only domain and email are implemented. The issue also offers search-by-username
# and search-by-phone; neither is built, because on a public unauthenticated
# tool they turn a compromise check into people-search.
HUDSONROCK_ENABLED=false

# Per-IP daily cap on upstream Hudson Rock calls. Cache hits do not count.
# The upstream quota is not ours to spend, so this is capped the same way the
# paid LLM endpoints are. Minimum 1; default 25.
# HUDSONROCK_PER_DAY=25

# ----- Registered-service enumeration, holehe (v3.34.0) -----
# Adds a "Registered Services" card to the Email Header tab's risk assessment:
# for one sender address, which of a curated list of mainstream services say the
# address already has an account. Only the service name and yes/no are ever
# rendered.
#
# DEFAULT OFF, and it is the one source here that should stay off unless you have
# read "holehe" in docs/deploy-runbook.md. This is not a vendor lookup. Enabling
# it makes YOUR server start a signup or login flow at every service on the
# allowlist, one outbound request each, per lookup. Consequences an operator is
# opting into:
#
#   - your IP makes ~20 outbound probes to third-party sites per lookup
#   - those sites may rate limit, CAPTCHA or block your address for it
#   - the traffic is attributable to you, under your OPERATOR_CONTACT_UA
#
# Hence the caps below and a per-IP limit of 5 lookups a day, an order of
# magnitude below every other source.
#
# The library is NOT in requirements.txt: it is GPL-3.0, unmaintained since 2024
# (PyPI 1.61 from 2022-07-21, repo last pushed 2024-09-10), and pulls in trio,
# tqdm, termcolor and colorama. Install it deliberately:
#   sudo /opt/falconeye/venv/bin/pip install 'holehe==1.61'
# With the library absent this source behaves exactly as if disabled.
HOLEHE_ENABLED=false

# Per-IP daily cap on enumerations. Cache hits do not count. Minimum 1; default 5.
# HOLEHE_PER_DAY=5

# Wall clock for one enumeration, in seconds. Services that do not answer inside
# it are dropped and the card says how many answered. Default 20.
# HOLEHE_TIMEOUT_SECONDS=20

# How many services may be probed at once. Default 4, hard-capped at 8 in code
# whatever you put here: this bounds the fan-out from your address.
# HOLEHE_CONCURRENCY=4

# ----- Operator identity (v3.33.0) -----
# Who runs THIS instance. Every default below reproduces the public instance, so
# an existing deployment that sets none of them is byte-for-byte unchanged.
#
# Set these if you self-host, or the site presents someone else's name, inbox
# and privacy policy as yours. Raised by an external self-hoster who asked how
# to hide the Contact page.
#
# The AGPL attribution and the link to the upstream repository are NOT affected
# by any of these and always render. That is the licence, not branding.
# OPERATOR_NAME=Your Name or Org
# OPERATOR_URL=https://example.com
# OPERATOR_CONTACT_EMAIL=contact@example.com
# OPERATOR_PRIVACY_EMAIL=privacy@example.com

# The contact token in every outbound User-Agent, so an upstream API with a
# complaint about your traffic knows who to reach. Until v3.33.1 this was
# hardcoded to the upstream operator's domain, so a self-hoster's queries to
# AbuseIPDB, VirusTotal, ransomware.live and the rest were attributed to
# someone with no connection to them. Set it to your own domain or contact.
# Some upstreams require attribution, so set it rather than blanking it.
# OPERATOR_CONTACT_UA=example.com

# The Contact tab. Leave unset (or "true") to keep it. Set to "false" and the
# nav entry disappears, the panel is not rendered, and GET /contact returns 404.
# CONTACT_ENABLED=false

# Where the contact form posts. Until v3.33.0 this was hardcoded to the upstream
# operator's Formspree form, which meant a self-hoster's visitors mailed someone
# else. Set your own endpoint, or leave it empty to drop the form and show only
# the contact details above.
# CONTACT_FORM_ACTION=

# ----- Logging -----
# Level for the app's own loggers ("falconeye.*"). INFO is the default and is
# what emits the per-source IP reputation lines
#   event=ip_source source=abuseipdb target=... status=ok latency_ms=142 cached=false
# Scoped to our loggers, so raising it does not also turn on httpx and uvicorn
# chatter. Set to WARNING for a quieter journal.
# FALCONEYE_LOG_LEVEL=INFO

# ----- Security / Developer -----
# Set to "true" ONLY in local development to enable /openapi.json, /api/docs, /redoc.
# Must be unset or "false" in production, these endpoints expose the full API surface.
# FALCONEYE_PUBLIC_DOCS=true

# Extra networks whose CF-Connecting-IP header may set the rate-limit key, as a
# comma-separated CIDR list. LEAVE THIS UNSET on the standard deployment.
#
# get_client_ip() already trusts the published Cloudflare ranges, and under
# nginx -> gunicorn the app sees the Cloudflare edge address as its peer, so
# nothing more is needed. This exists only for a deployment where the app sees
# the reverse proxy's own address instead (proxy headers disabled, a different
# fronting setup). Every CIDR listed here is a network allowed to name any IP it
# likes as the rate-limited client, which is the whole limit, on paid LLM
# endpoints. Do not add 0.0.0.0/0.
# TRUSTED_PROXY_CIDRS=127.0.0.1/32

# ----- Route Map (v3.35.0) -----
# Maps the real network path to a target. The trace always comes from the
# user's side: a RIPE Atlas probe near them, a trace they pasted, or a trace
# they ran themselves and piped to the ingest endpoint. This server never runs
# a traceroute and is never the origin of the path.

# CAIDA Hoiho, the router-hostname geolocation source. Free, keyless, published
# research infrastructure. ON by default; it is the thing that makes this tab
# more accurate than plotting an IP database, so switch it off only
# deliberately. What is sent: public router hostnames from the trace, never a
# private hop and nothing about the visitor. Cached 30 days.
# HOIHO_ENABLED=false

# ---- RIPE Atlas ----
# OFF by default, and it needs an account and an API key.
#
# READ THIS BEFORE ENABLING. Three consequences you are agreeing to:
#   1. Measurements are PUBLIC. RIPE Atlas publishes one-off measurements,
#      including the target your visitors type, in its public measurement
#      database. The tab says so next to the button and the privacy policy
#      says so. You cannot turn that off.
#   2. They cost credits. One traceroute is 30 credits
#      (RIPE's formula: 10 * packets * (int(size/1500)+1), so 10*3*1).
#      An account earns about 21,600 credits a day per probe it hosts, and a
#      new account can claim a one-time 50,000.
#   3. The target is sent to RIPE. Your visitors' coordinates are NOT: the
#      probe is chosen by AS number and nearest published probe coordinates,
#      never by handing RIPE a location filter.
#
# Create the key at https://atlas.ripe.net/keys/ with ONLY these permissions:
#   - Get credit income info / balance
#   - Schedule a new measurement
# Results are public and are fetched without the key.
# ATLAS_ENABLED=true
# ATLAS_API_KEY=
# Daily ceiling in credits, enforced by this instance and not only by RIPE.
# 15000 is 500 traceroutes a day, comfortably inside what one hosted probe
# earns (about 21,600 a day).
# ATLAS_DAILY_CREDIT_CAP=15000
# Per-IP daily cap on Atlas traces.
# ATLAS_PER_DAY=10
# Wall clock for one measurement before the tab offers the manual fallback.
# ATLAS_MEASUREMENT_TIMEOUT_SECONDS=120

# ---- run-it-yourself upload ----
# Always available, no key. The tab mints a single-use token and shows a
# one-line command that pipes the user's own traceroute output to the ingest
# endpoint. Nothing is downloaded and nothing is executed from this server.
# The handshake between the uploading shell and the waiting browser lives in
# Redis (already a dependency), never in the database, and expires with the
# token.
# ROUTEMAP_TOKEN_TTL_SECONDS=600
# ROUTEMAP_TOKENS_PER_DAY=30
# ROUTEMAP_ANALYSES_PER_DAY=60
