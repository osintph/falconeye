[Unit]
Description=FalconEye OSINT toolkit
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/falconeye/app_src
EnvironmentFile=/opt/falconeye/.env
# systemd creates /var/log/falconeye before ExecStart and gives it to User=/Group=.
#
# Without this the unit pointed gunicorn's --access-logfile and --error-logfile at
# a directory nothing in the unit created. scripts/provision.sh made it, so the
# reference deployment and anyone who ran the provisioner never noticed; a manual
# install, or an upgrade on a box that had lost the directory, crash-looped with
# PermissionError on /var/log/falconeye/error.log before serving a single request.
#
# systemd.exec(5): the named directory is created below /var/log/, owned by User=
# and Group=, and "if the specified directories already exist and their owning
# user or group do not match the configured ones ... file ownership [is]
# recursively changed to match what is configured". So this also repairs a
# directory that exists with the wrong owner. The mode comes from
# LogsDirectoryMode=, which defaults to 0755. The directory is NOT removed when
# the unit stops, so existing logs survive a restart.
LogsDirectory=falconeye
# --forwarded-allow-ips is pinned, not left to the default, because every per-IP
# rate limit depends on it. uvicorn's ProxyHeadersMiddleware rewrites the client
# peer from X-Forwarded-For only for peers in this list; nginx appends its
# $remote_addr (the Cloudflare edge IP) as the right-most entry, and that is what
# app/utils/client_ip.py checks against the Cloudflare ranges.
#
# Setting it to "*" would make uvicorn take the LEFT-most X-Forwarded-For entry,
# which is fully caller-supplied, the peer address becomes attacker-chosen and
# every rate limit falls over. gunicorn reads FORWARDED_ALLOW_IPS from the
# environment, and EnvironmentFile= below puts .env into that environment, so
# without this explicit flag one line in .env could do exactly that. An explicit
# CLI flag wins over the env var; keep it.
ExecStart=/opt/falconeye/venv/bin/gunicorn app.main:app \
    --bind 127.0.0.1:8000 \
    --workers 3 \
    --worker-class uvicorn.workers.UvicornWorker \
    --forwarded-allow-ips 127.0.0.1 \
    --timeout 90 \
    --access-logfile /var/log/falconeye/access.log \
    --error-logfile /var/log/falconeye/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
